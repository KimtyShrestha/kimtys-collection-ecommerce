# Dependencies
node_modules/

# Environment variables (never commit secrets)
.env
.env.local
.env.production

# Build output
dist/
build/

# Uploaded files (runtime content, not source)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# OS files
Thumbs.db
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json

# Database dumps (local only)
*.dump